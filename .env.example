# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다.
#   cp .env.example .env
#
# 아래 DB 값은 Docker 경로와 로컬 MySQL 경로가 반드시 동일해야 한다.
# 값이 갈리면 "내 PC 에서만 되는" 문제가 생긴다.

# ---------- MySQL 컨테이너 초기화 ----------
MYSQL_DATABASE=foten
MYSQL_USER=foten
MYSQL_PASSWORD=foten
MYSQL_ROOT_PASSWORD=root

# ---------- 애플리케이션이 붙을 DB ----------
# Docker 경로: 호스트명이 컨테이너 이름(mysql)
DB_URL=jdbc:mysql://mysql:3306/foten?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
#
# 로컬 MySQL 경로: 위를 주석 처리하고 아래를 쓴다
# DB_URL=jdbc:mysql://localhost:3306/foten?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
#
# 공용 원격 DB 로 전환할 때도 이 한 줄만 바꾼다 (docs/SETUP.md 참고)
# DB_URL=jdbc:mysql://<원격호스트>:3306/foten?sslMode=REQUIRED&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=foten
DB_PASSWORD=foten

# ---------- 애플리케이션 ----------
# 비-Docker(IDE) 실행용 값이다. Docker 로 띄우면 compose 가 docker 로 덮어쓴다.
SPRING_PROFILES_ACTIVE=local
TZ=Asia/Seoul

# ---------- 외부 연동 ----------
# 생성형 AI API 키. 값을 커밋하지 않는다.
LLM_API_KEY=
LLM_MODEL=

# 한국수출입은행 환율 Open API 인증키
# https://www.koreaexim.go.kr 에서 발급
EXIM_API_KEY=
# 환율 배치 실행 시각 (cron). 수출입은행 API 는 영업일 11시 이후 당일 고시가 올라온다.
EXCHANGE_RATE_CRON=0 0 12 * * *
