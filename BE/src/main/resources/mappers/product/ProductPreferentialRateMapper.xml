<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.foten.product.mapper.ProductPreferentialRateMapper">

    <select id="selectByProductIds" resultType="com.foten.product.domain.ProductPreferentialRateVO">
        SELECT product_preferential_rate_id,
               product_id,
               condition_code,
               rate_bonus
        FROM product_preferential_rate
        WHERE product_id IN
        <foreach collection="productIds" item="productId" open="(" separator="," close=")">
            #{productId}
        </foreach>
    </select>

</mapper>
