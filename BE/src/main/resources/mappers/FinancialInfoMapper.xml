<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.foten.goal.mapper.FinancialInfoMapper">

    <select id="selectByMemberId" resultType="com.foten.goal.domain.FinancialInfo">
        SELECT member_id,
               monthly_income,
               monthly_living_cost,
               monthly_remittance,
               current_savings,
               updated_at
        FROM financial_info
        WHERE member_id = #{memberId}
    </select>

</mapper>
