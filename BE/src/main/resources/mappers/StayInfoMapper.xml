<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.foten.goal.mapper.StayInfoMapper">

    <select id="selectByMemberId" resultType="com.foten.goal.domain.StayInfo">
        SELECT member_id,
               visa_type,
               entry_date,
               expected_return_date,
               updated_at
        FROM stay_info
        WHERE member_id = #{memberId}
    </select>

</mapper>
