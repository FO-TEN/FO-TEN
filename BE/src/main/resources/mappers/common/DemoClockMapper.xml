<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.foten.common.mapper.DemoClockMapper">

    <select id="findToday" resultType="java.time.LocalDate">
        SELECT today
        FROM demo_clock
        WHERE member_id = #{memberId}
    </select>

</mapper>
